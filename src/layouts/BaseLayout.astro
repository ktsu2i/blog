---
import { Font } from "astro:assets";
import avatar from "../assets/avatar.jpg";
import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";
import "../styles/globals.css";
import {
  getCurrentLocale,
  useTranslations,
  getAlternatePath,
} from "../i18n/config";

interface Props {
  title?: string;
  description?: string;
  ogType?: string;
  publishedTime?: string;
  ogImage?: string;
  noindex?: boolean;
}

const locale = getCurrentLocale(Astro);
const t = useTranslations(locale);

const {
  title,
  description = t["common.siteDescription"],
  ogType = "website",
  publishedTime,
  ogImage,
  noindex = false,
} = Astro.props;

const siteUrl = Astro.site!.origin;
const siteName = t["common.siteName"];
const pageTitle = title ? `${title} | ${siteName}` : t["common.defaultTitle"];
const ogLocale = locale === "ja" ? "ja_JP" : "en_US";
const currentPath = Astro.url.pathname;
const canonicalUrl = new URL(currentPath, siteUrl).href;
const jaUrl = `${siteUrl}${getAlternatePath(currentPath, "ja")}`;
const enUrl = `${siteUrl}${getAlternatePath(currentPath, "en")}`;
const rssHref = locale === "ja" ? "/feed.xml" : "/en/feed.xml";

const person = {
  "@type": "Person",
  name: "筒井海人",
  alternateName: "Kaito Tsutsui",
  url: siteUrl,
  image: new URL(avatar.src, siteUrl).href,
  jobTitle: "Software Engineer",
  sameAs: [
    "https://github.com/ktsu2i",
    "https://x.com/ktsu2i",
    "https://www.linkedin.com/in/ktsu2i",
    "https://zenn.dev/ktsu2i",
  ],
};
const schemas: object[] = [{ "@context": "https://schema.org", ...person }];
if (ogType === "article") {
  schemas.push({
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    headline: title,
    description,
    datePublished: publishedTime,
    image: ogImage && `${siteUrl}${ogImage}`,
    url: canonicalUrl,
    mainEntityOfPage: canonicalUrl,
    inLanguage: locale,
    author: { "@type": "Person", name: person.name, url: person.url },
  });
}
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" type="image/png" href="/images/favicon.png" />
    <link rel="apple-touch-icon" href="/images/apple-touch-icon.png" />
    <Font cssVariable="--font-geist-sans" preload />
    <Font cssVariable="--font-geist-mono" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:type" content={ogType} />
    {publishedTime && (
      <meta property="article:published_time" content={publishedTime} />
    )}
    {ogImage && <meta property="og:image" content={`${siteUrl}${ogImage}`} />}
    <meta
      name="twitter:card"
      content={ogImage ? "summary_large_image" : "summary"}
    />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    {ogImage && <meta name="twitter:image" content={`${siteUrl}${ogImage}`} />}
    {noindex ? (
      <meta name="robots" content="noindex" />
    ) : (
      <>
        <link rel="alternate" hreflang="ja" href={jaUrl} />
        <link rel="alternate" hreflang="en" href={enUrl} />
        <link rel="alternate" hreflang="x-default" href={jaUrl} />
        <link rel="canonical" href={canonicalUrl} />
      </>
    )}
    <link
      rel="alternate"
      type="application/rss+xml"
      href={`${siteUrl}${rssHref}`}
      title={siteName}
    />
    {schemas.map((schema) => (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    ))}
    <script is:inline>
      (function () {
        const stored = localStorage.getItem("theme");
        const dark =
          stored === "dark" ||
          (!stored &&
            window.matchMedia("(prefers-color-scheme: dark)").matches);
        document.documentElement.classList.toggle("dark", dark);
      })();
    </script>
  </head>
  <body class="font-sans antialiased">
    <Header />
    <main class="mx-auto min-h-screen max-w-4xl px-6 py-8">
      <slot />
    </main>
    <Footer />
  </body>
</html>
