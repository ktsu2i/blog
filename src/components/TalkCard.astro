---
import { ExternalLink, Presentation } from "lucide-react";
import { Image } from "astro:assets";
import { buttonVariants } from "@/components/ui/button";
import type { Talk } from "../lib/types";
import { formatDate, toDateAttr } from "../lib/utils";
import { getCurrentLocale, useTranslations } from "../i18n/config";

interface Props {
  talk: Talk;
}

const { talk } = Astro.props;
const locale = getCurrentLocale(Astro);
const t = useTranslations(locale);
---

<div class="bg-card text-card-foreground flex flex-col gap-6 rounded-xl border py-6 shadow-sm">
  <div class="grid auto-rows-min grid-rows-[auto_auto] items-start gap-2 px-6">
    <div class="leading-snug font-semibold text-lg line-clamp-2 min-h-[2.75em]">
      {talk.title}
    </div>
    <div class="text-muted-foreground text-sm flex min-w-0 flex-col sm:flex-row sm:gap-1">
      <span class="truncate">{talk.event}</span>
      <span class="hidden sm:inline" aria-hidden="true">
        /
      </span>
      <time datetime={toDateAttr(talk.date)} class="shrink-0">
        {formatDate(talk.date, locale)}
      </time>
    </div>
  </div>
  <div class="px-6 space-y-4">
    <p class="text-sm text-muted-foreground line-clamp-3 min-h-15">
      {talk.description}
    </p>
    <div class="aspect-video w-full overflow-hidden rounded-lg border">
      <button
        type="button"
        class="group relative block h-full w-full cursor-pointer"
        data-speakerdeck-facade
        data-embed-url={talk.embedUrl}
        data-title={talk.title}
        aria-label={`${t["talks.playSlides"]}: ${talk.title}`}
      >
        <Image
          src={talk.thumbnailUrl}
          alt=""
          width={640}
          height={360}
          class="h-full w-full object-cover"
        />
        <span class="absolute right-2 bottom-2 inline-flex items-center gap-1.5 rounded-md border bg-background/90 px-2 py-1 text-xs font-medium text-foreground shadow-sm transition-colors group-hover:bg-accent group-focus-visible:bg-accent">
          <Presentation className="size-3.5" />
          {t["talks.playSlides"]}
        </span>
      </button>
    </div>
  </div>
  <div class="flex items-center px-6">
    <a
      href={talk.speakerdeckUrl}
      target="_blank"
      rel="noopener noreferrer"
      class={buttonVariants({ variant: "outline", size: "sm" })}
    >
      {t["talks.viewOnSpeakerDeck"]}
      <ExternalLink className="size-3.5" />
      <span class="sr-only">{t["common.opensInNewTab"]}</span>
    </a>
  </div>
</div>

<script>
  // Load the Speaker Deck player only on demand; it ships ~1MB of scripts
  document
    .querySelectorAll<HTMLButtonElement>("[data-speakerdeck-facade]")
    .forEach((button) => {
      button.addEventListener(
        "click",
        () => {
          const iframe = document.createElement("iframe");
          iframe.src = button.dataset.embedUrl ?? "";
          iframe.title = button.dataset.title ?? "";
          iframe.className = "h-full w-full";
          iframe.allowFullscreen = true;
          button.replaceWith(iframe);
          iframe.focus();
        },
        { once: true },
      );
    });
</script>
