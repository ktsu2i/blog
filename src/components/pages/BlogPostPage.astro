---
import { type CollectionEntry, render } from "astro:content";
import { format } from "date-fns";
import BaseLayout from "../../layouts/BaseLayout.astro";
import SourceBadge from "../post/SourceBadge.astro";
import { getPostDescription } from "../../lib/posts";
import { POST_SOURCES } from "../../lib/types";
import {
  getCurrentLocale,
  getLocalePath,
  useTranslations,
} from "../../i18n/config";

interface Props {
  post: CollectionEntry<"postsJa"> | CollectionEntry<"postsEn">;
}

const { post } = Astro.props;
const locale = getCurrentLocale(Astro);
const t = useTranslations(locale);
const { Content } = await render(post);
const formattedDate = format(new Date(post.data.date), t["date.format"]);
---

<BaseLayout
  title={post.data.title}
  description={getPostDescription(post)}
  ogType="article"
  publishedTime={post.data.date}
  ogImage={getLocalePath(`/og/${post.id}.png`, locale)}
>
  <article class="space-y-8">
    <header class="space-y-4">
      <h1 class="text-3xl font-bold tracking-tight">{post.data.title}</h1>
      <div class="flex flex-wrap items-center gap-2">
        <time class="text-sm text-muted-foreground">{formattedDate}</time>
        <SourceBadge source={POST_SOURCES.BLOG} />
      </div>
    </header>
    <div class="prose dark:prose-invert max-w-none">
      <Content />
    </div>
  </article>
</BaseLayout>

<script>
  // Render X embeds; widgets.js reads data-theme only on first render
  const tweets = document.querySelectorAll(".twitter-tweet");
  if (tweets.length > 0) {
    const dark = document.documentElement.classList.contains("dark");
    for (const tweet of tweets) {
      tweet.setAttribute("data-theme", dark ? "dark" : "light");
    }
    const script = document.createElement("script");
    script.src = "https://platform.twitter.com/widgets.js";
    script.async = true;
    document.body.append(script);
  }
</script>
