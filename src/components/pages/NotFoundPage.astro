---
import { ArrowLeft } from "lucide-react";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { buttonVariants } from "@/components/ui/button";
import {
  getCurrentLocale,
  useTranslations,
  getLocalePath,
} from "../../i18n/config";

const locale = getCurrentLocale(Astro);
const t = useTranslations(locale);
---

<BaseLayout title="404" noindex>
  <div class="flex flex-col items-center justify-center gap-8 py-24 text-center">
    <p class="text-[10rem] leading-none font-bold tracking-tighter select-none sm:text-[14rem] drop-shadow-[0_0_24px_var(--prose-accent-light)]">
      404
    </p>

    <div class="mx-auto h-px w-24 bg-linear-to-r from-transparent via-(--prose-accent) to-transparent"></div>

    <div class="space-y-4">
      <p class="text-lg text-muted-foreground">{t["notFound.message"]}</p>

      <a href={getLocalePath("/", locale)} class={buttonVariants()}>
        <ArrowLeft className="size-4" />
        {t["notFound.backHome"]}
      </a>
    </div>
  </div>
</BaseLayout>
