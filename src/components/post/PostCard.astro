---
import { Image } from "astro:assets";
import { ExternalLink } from "lucide-react";
import { badgeVariants } from "@/components/ui/badge";
import SourceBadge from "./SourceBadge.astro";
import { POST_SOURCES, type Post } from "../../lib/types";
import { formatDate, toDateAttr } from "../../lib/utils";
import {
  getCurrentLocale,
  useTranslations,
  getLocalePath,
} from "../../i18n/config";

interface Props {
  post: Post;
  // Above-the-fold card whose image is likely the LCP element
  priority?: boolean;
}

const { post, priority = false } = Astro.props;
const locale = getCurrentLocale(Astro);
const t = useTranslations(locale);
const isJapaneseOnly = locale === "en" && post.locale !== "en";
const href =
  post.source === POST_SOURCES.BLOG && post.slug
    ? getLocalePath(`/blog/${post.slug}/`, isJapaneseOnly ? "ja" : locale)
    : post.url;
const isExternal = post.source !== POST_SOURCES.BLOG;
// Local OG images come from an endpoint that astro:assets cannot transform
const responsiveImage = post.ogImage?.startsWith("https://")
  ? {
      widths: [416, 832],
      sizes:
        "(min-width: 896px) 416px, (min-width: 768px) calc(50vw - 32px), calc(100vw - 48px)",
    }
  : {};
---

<a
  href={href}
  data-source={post.source}
  target={isExternal ? "_blank" : undefined}
  rel={isExternal ? "noopener noreferrer" : undefined}
  class="block h-full rounded-xl"
>
  <div class="bg-card text-card-foreground flex h-full flex-col gap-6 rounded-xl border py-6 shadow-sm overflow-hidden transition-colors hover:bg-accent/50">
    {post.ogImage && (
      <div class="relative aspect-40/21 px-0 -mt-6 overflow-hidden border-b border-border/70">
        <Image
          src={post.ogImage}
          alt={post.title}
          width={1200}
          height={630}
          {...responsiveImage}
          class="h-full w-full object-cover ring-1 ring-inset ring-border/60"
          loading={priority ? "eager" : "lazy"}
          fetchpriority={priority ? "high" : undefined}
        />
      </div>
    )}
    <div class="grid auto-rows-min grid-rows-[auto_auto] items-start gap-2 px-6">
      <div class="flex items-center gap-2">
        <time
          datetime={toDateAttr(post.date)}
          class="text-sm text-muted-foreground"
        >
          {formatDate(post.date, locale)}
        </time>
        <SourceBadge source={post.source} />
        {isJapaneseOnly && (
          <span class={badgeVariants({ variant: "notice" })}>
            {t["blog.japaneseOnly"]}
          </span>
        )}
      </div>
      <div class="leading-snug font-semibold text-lg">
        <span class="inline">
          {post.title}
          {isExternal && (
            <>
              <ExternalLink className="ml-1 inline-block size-4 align-text-bottom text-muted-foreground" />
              <span class="sr-only">{t["common.opensInNewTab"]}</span>
            </>
          )}
        </span>
      </div>
    </div>
    <div class="mt-auto px-6">
      <div class="text-muted-foreground text-sm line-clamp-2">
        {post.description}
      </div>
    </div>
  </div>
</a>
