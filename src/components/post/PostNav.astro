---
import { ArrowLeft } from "lucide-react";
import { buttonVariants } from "@/components/ui/button";
import { cn } from "../../lib/utils";
import type { Post } from "../../lib/types";
import {
  getCurrentLocale,
  getLocalePath,
  useTranslations,
} from "../../i18n/config";

interface Props {
  newer?: Post;
  older?: Post;
}

const { newer, older } = Astro.props;
const locale = getCurrentLocale(Astro);
const t = useTranslations(locale);
const links = [
  older && { post: older, label: t["post.older"], align: "items-start" },
  newer && {
    post: newer,
    label: t["post.newer"],
    align: "items-end text-right sm:col-start-2",
  },
].filter((link) => !!link);
---

<div class="mt-12 space-y-8 border-t pt-8">
  {links.length > 0 && (
    <nav aria-label={t["post.nav.label"]} class="grid gap-4 sm:grid-cols-2">
      {links.map(({ post, label, align }) => (
        <a
          href={getLocalePath(`/blog/${post.slug}/`, locale)}
          class={cn(
            "flex flex-col gap-1 rounded-xl border p-4 transition-colors hover:bg-accent/50",
            align,
          )}
        >
          <span class="text-sm text-muted-foreground">{label}</span>
          <span class="font-semibold leading-snug">{post.title}</span>
        </a>
      ))}
    </nav>
  )}
  <div class="flex justify-center">
    <a
      href={getLocalePath("/blog/", locale)}
      class={buttonVariants({ variant: "outline" })}
    >
      <ArrowLeft className="size-4" />
      {t["post.backToBlog"]}
    </a>
  </div>
</div>
