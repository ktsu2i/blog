---
import { buttonVariants } from "@/components/ui/button";
import { POST_SOURCES, type PostSource } from "@/lib/types";
import { cn } from "@/lib/utils";

type SourceFilter = "all" | PostSource;

interface Props {
  // Id of the server-rendered list whose children carry data-source
  listId: string;
  translations: {
    all: string;
    filterLabel: string;
  };
}

const { listId, translations } = Astro.props;
const sources: SourceFilter[] = ["all", ...Object.values(POST_SOURCES)];
// Outline by default, the default variant's look while aria-pressed, so the
// script only has to flip aria-pressed
const buttonClass = cn(
  buttonVariants({ variant: "outline", size: "sm" }),
  "aria-pressed:border-0 aria-pressed:bg-primary aria-pressed:text-primary-foreground aria-pressed:shadow-none aria-pressed:hover:bg-primary/90 aria-pressed:hover:text-primary-foreground dark:aria-pressed:bg-primary dark:aria-pressed:hover:bg-primary/90",
);
---

<div
  role="group"
  aria-label={translations.filterLabel}
  class="flex flex-wrap items-center gap-2"
  data-post-filter
>
  {sources.map((source) => (
    <button
      type="button"
      class={buttonClass}
      aria-pressed={source === "all" ? "true" : "false"}
      aria-controls={listId}
      data-source={source}
    >
      {source === "all" ? translations.all : source}
    </button>
  ))}
</div>

<script>
  import { initPostFilters } from "@/lib/post-filter";

  initPostFilters();
</script>
